<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used after you tap Record, with a visible indicator. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: only for the optional "gaming session" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission (granted automatically): lets FLEXY read network type
         and detect when you are offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed only for: the FREE plan's launch ad, the consent form, and the PLUS purchase.
         Voice recordings are NEVER uploaded. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Lets FLEXY see launchable apps (to find games) WITHOUT the restricted
         QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.samsung.android.game.gamehome" />
        <package android:name="com.oplus.games" />
    </queries>

    <application
        android:name=".FlexyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flexy">

        <!-- Google AdMob app id (test id by default, see gradle.properties). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Official AdMob flag: don't start app measurement until consent is handled. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Used only when YOU tap Share on a recording. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
